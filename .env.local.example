# SMTP configuration for the contact form email service.
# The API route sends enquiry emails to corvus@openpic.in.
#
# Copy this file to .env.local and fill in your credentials.
# Without these, the API falls back to console logging (dev mode).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
